{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "regista-api",
      "runtimeExecutable": "uvicorn",
      "runtimeArgs": [
        "regista.api:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "regista-offline",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "REGISTA_DOTENV=",
        "uvicorn",
        "regista.api:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8040"
      ],
      "port": 8040
    }
  ]
}
