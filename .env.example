# Copy to .env (git-ignored) or let infra/provision.sh write it. Foundry, Cosmos DB and AI Search use Entra ID:
# `az login` locally, managed identity in Azure Container Apps. Leave a variable empty to keep the local rule-based agent.
FOUNDRY_PROJECT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>
FOUNDRY_MODEL=gpt-5-mini
REGISTA_COSMOS_ENDPOINT=https://<account>.documents.azure.com:443/
REGISTA_COSMOS_DATABASE=regista
REGISTA_SEARCH_ENDPOINT=https://<service>.search.windows.net
# REGISTA_COSMOS_KEY=            # only if you cannot use Entra ID roles
# REGISTA_CLOUD=1                # service: use Foundry/Cosmos agents for uploads when configured
